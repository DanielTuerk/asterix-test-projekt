<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dtuerk</groupId>
        <artifactId>asterix-test-projekt</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>asterix-infra</artifactId>
    <name>asterix-infra</name>
    <description>Startet Kafka und PostgreSQL per Testcontainers auf festen Ports - die gemeinsame Infrastruktur fuer Receiver und Persister</description>

    <dependencies>
        <!-- Hier ist Testcontainers kein Test-, sondern das eigentliche Werkzeug. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
        </dependency>
        <!-- Testcontainers loggt ueber SLF4J; ohne Binding bliebe die Konsole stumm. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>dtuerk.asterix.infra.AsterixInfrastruktur</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
