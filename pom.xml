<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>dtuerk</groupId>
    <artifactId>asterix-test-projekt</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>asterix-test-projekt</name>
    <description>Einarbeitung in EUROCONTROL ASTERIX und Apache Camel</description>

    <modules>
        <module>asterix-common</module>
        <module>asterix-infra</module>
        <module>spring-camel-asterix-sender</module>
        <module>spring-camel-asterix-receiver</module>
        <module>spring-camel-asterix-persister</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <camel.version>4.22.0</camel.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Legt die Versionen aller camel-*-starter fest, passend zu Spring Boot. -->
            <dependency>
                <groupId>org.apache.camel.springboot</groupId>
                <artifactId>camel-spring-boot-bom</artifactId>
                <version>${camel.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Testwerkzeuge braucht jedes Modul. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-test-spring-junit5</artifactId>
            <!-- Nicht im camel-spring-boot-bom enthalten, daher explizit. -->
            <version>${camel.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
